# WARNING: Remove .empty for use

# Discord Token
DISCORD_BOT_TOKEN=

# ----------------------- #
# LLM Provider (v2)
# Changing models/providers is configuration only — no code changes needed.
# LLM_PROVIDER options: koboldcpp (default), ollama, lmstudio, openai
LLM_PROVIDER=koboldcpp
# Override the chat-completions endpoint (optional; each provider has a sane default)
LLM_API_URL=
# API key for hosted providers (optional; openai falls back to OPENAI_API_KEY)
LLM_API_KEY=
# Model name (optional; openai falls back to GPT_ENGINE; local servers use their loaded model)
LLM_MODEL=
# Request timeout in seconds
LLM_TIMEOUT=60

# KoboldAI URL (legacy; used when LLM_PROVIDER=koboldcpp and LLM_API_URL is unset)
KOBOLD_TEXT_API=http://127.0.0.1:5001/v1/chat/completions
KOBOLD_IMG_API= http://127.0.0.1:5001/sdapi/v1
KOBOLD_WEB_API=http://127.0.0.1:5001/api/extra/websearch

# WeatherAPI Key
WeatherAPI_KEY= 

# Official OpenAI API authentication
OPENAI_API_KEY=

# ----------------------- #
# Optional setting

# CHAT_MODEL option: OFFICIAL, UNOFFICIAL, Bard, Bing
CHAT_MODEL=OFFICIAL
# GPT_ENGINE option: gpt-4.1-nano, gpt-4.1-mini, gpt-4.1, gpt-5
GPT_ENGINE=gpt-4.1-nano
LOGGING=True
REPLYING_ALL=False
